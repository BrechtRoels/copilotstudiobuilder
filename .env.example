# PwC GenAI Shared Service
GENAI_BASE_URL=https://genai-sharedservice-emea.pwc.com
GENAI_API_KEY=sk-your-key-here
GENAI_API_VERSION=
# Model for authoring YAML/flows (strong) and for doc summaries (cheap)
GENAI_LLM_MODEL=openai.gpt-4.1
GENAI_FAST_MODEL=openai.gpt-4.1-mini
# Output token cap per call (service default is 4096, too small for multi-file proposals)
GENAI_MAX_OUTPUT_TOKENS=32000
# true = canned responses, no tokens spent (UI work / demos)
USE_MOCK_AI=false
# LLM repair rounds when generated YAML fails Microsoft's schema
AI_REPAIR_ATTEMPTS=2

# Where new workspaces are created (default: ./workspaces)
# WORKSPACES_DIR=

# Optional: local clone of https://github.com/microsoft/skills-for-copilot-studio
# enables Deploy → Validate (LSP) / Preview / Pull / Push. Also needs Node 18+ and
# the Copilot Studio VS Code extension.
# MCS_SKILLS_DIR=/Users/you/src/skills-for-copilot-studio
